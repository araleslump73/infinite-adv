{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "avventura-infinita",
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "config.json",
      "config.example.json",
      "ai-stato.json",
      "server.js",
      "prova-*.js",
      "prova-*.html",
      "README.md",
      "PIANO.md",
      "screenshot-*.png"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
